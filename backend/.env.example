# Copy to backend/.env and adjust. Never commit the real .env file.

# Secret used to sign JWTs. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins (default: *)
CORS_ORIGINS=http://localhost:3000

# Upload size limits in megabytes
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
